// gmlscan-ignore-file gml/unused-function -- GameMaker 1.x import glue, invoked via gml_pragma or kept for its enum
function __init_background()
{
	enum e__BG
	{
		Visible = 0,
		Foreground = 1,
		Index = 2,
		X = 3,
		Y = 4,
		Width = 5,
		Height = 6,
		HTiled = 7,
		VTiled = 8,
		XScale = 9,
		YScale = 10,
		HSpeed = 11,
		VSpeed = 12,
		Blend = 13,
		Alpha = 14,
	}
}
